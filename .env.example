# Copy to .env. Never send the cookie to an agent or commit it.
X5_COOKIE=""
# Relative paths resolve against the directory containing this .env.
X5_DB_PATH="data/x5.sqlite"
X5_NETWORK_CODES="D,S,VK,SL,VP"
X5_REQUEST_TIMEOUT_MS=30000
X5_PAGE_DELAY_MS=500
X5_MAX_PAGES_PER_MONTH=1000
# First sync requires explicit dates or X5_SYNC_FROM. Later sync overlaps 7 days.
X5_SYNC_FROM=
# 0 disables the network sync MCP tool; CLI sync remains available.
X5_ENABLE_SYNC_TOOL=1
