{
  "name": "x5-purchases-mcp",
  "version": "0.1.0",
  "private": true,
  "description": "Local X5 Club purchase history and analytics over MCP stdio",
  "type": "module",
  "engines": { "node": ">=24 <25" },
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:built": "node scripts/test-built.mjs",
    "dev": "tsx src/index.ts",
    "start": "node dist/index.js",
    "x5:probe": "tsx src/cli.ts probe",
    "x5:sync": "tsx src/cli.ts sync",
    "x5:recent": "tsx src/cli.ts recent",
    "x5:search": "tsx src/cli.ts search",
    "x5:status": "tsx src/cli.ts status"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "^2.0.0",
    "better-sqlite3": "^12.0.0",
    "dotenv": "^17.0.0",
    "turbo-stream": "~2.4.1",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@modelcontextprotocol/client": "^2.0.0",
    "@types/better-sqlite3": "^7.6.0",
    "@types/node": "^24.0.0",
    "eslint": "^9.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.0.0",
    "vitest": "^3.2.0"
  },
  "pnpm": { "onlyBuiltDependencies": ["better-sqlite3", "esbuild"] }
}
